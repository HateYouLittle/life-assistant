# Life Assistant 进程不会自动加载此文件。前台运行前请 source，生产环境可通过
# systemd EnvironmentFile 加载。

# 共享 SQLite/WAL 目录。生产环境使用绝对路径；所有 MCP 进程与唯一 scheduler
# 必须使用同一路径。
DATA_DIR=/absolute/path/to/life-assistant/data

# Profile -> Hermes deliver-only Webhook route。公共事件按已配置 Profile 独立
# fan-out，私有日程仍只属于其 Profile。URL 必须为 HTTP(S) 且主机名仅为
# 127.0.0.1 或 [::1]（localhost 会被拒绝），route 必须与 Hermes subscription
# 同名，每个 secret 必须是独立、安全生成的 64 位 hex。
# 真实 .env 权限应为 600，禁止提交 Git。
# 整个单行 JSON 必须用单引号包裹，才能同时安全用于 bash source 和 systemd EnvironmentFile。
# 可选字段 renderTarget 指定该 Profile 的平台渲染目标，取值：
#   "plain"（纯文本，缺省兜底） / "qq-markdown" / "feishu-markdown" / "wechat-markdown"
# renderTarget 缺省或未知值时按 plain 处理，且只影响该字段配置之后新生成的通知快照。
# PROFILE_PUSH_ROUTES_JSON='{"<profile>":{"route":"life-assistant-<profile>","url":"http://127.0.0.1:<port>/webhooks/life-assistant-<profile>","secret":"<64-hex-secret>","renderTarget":"qq-markdown"}}'
PROFILE_PUSH_ROUTES_JSON=

# 可选 Profile 显示名映射（单行 JSON）：共享账本通知的「记录人」等场景用友好名
# 替代 profile id。非法 JSON / 非字符串值一律丢弃该字段，profile id 仍会回落显示。
# 整个单行 JSON 必须用单引号包裹（同 PROFILE_PUSH_ROUTES_JSON）。
# PROFILE_DISPLAY_NAMES='{"default":"我","bestie":"对象"}'
PROFILE_DISPLAY_NAMES=

# MCP 进程的 Profile 身份；必填且不得静默回退。可由 hermes mcp add 的
# --env HERMES_PROFILE=<profile> 注入，不一定要写入本文件。
HERMES_PROFILE=default

# 可选共享位置预置。三项都留空时由 Agent 引导确认。
LOCATION_CITY=
LOCATION_LAT=
LOCATION_LON=

# scheduler 简报/预警渲染时区、schedule 默认时区，以及确定性每日生活简报 cron。
LIFE_ASSISTANT_TIMEZONE=Asia/Shanghai
DAILY_WEATHER_BRIEF_CRON="0 7 * * *"
# WEATHER_ALERTS_CRON="*/15 * * * *"
# OIL_WATCH_CRON="0 9 * * *"

# 中国大陆节假日安排的每日刷新 cron（Asia/Shanghai）。每天确保当年数据可用；
# 每年 10 月起还会尝试获取下一年国务院放假安排。留空使用默认 0 2 * * *。
HOLIDAY_REFRESH_CRON="0 2 * * *"

# 记账月度账单 cron：每月 1 号推送上月个人 + 各共享账本收支汇总。
# 留空使用默认 0 9 1 * *（每月 1 日 09:00，时区取 LIFE_ASSISTANT_TIMEZONE）。
# BOOKKEEPING_REPORT_CRON="0 9 1 * *"

# 自动任务扫描 cron：scheduler 按该周期扫描到期的 automation 任务
# （单任务的 daily/interval 调度在其自身 schedule 中定义）。留空使用默认 */10 * * * *。
# AUTOMATION_SCAN_CRON="*/10 * * * *"

# 可选天气 Provider。配置后优先 QWeather，Open-Meteo 作为兜底。
# 新式 API Key 绑定专属 host（控制台「设置 → API Host」，形如 xxx.re.qweatherapi.com），
# 必须把 QWEATHER_API_HOST 改成该专属 host，否则全部 403 Invalid Host 并静默降级 Open-Meteo
# （官方预警也不可用）；旧订阅 key 才保持默认 devapi.qweather.com。
QWEATHER_KEY=
QWEATHER_API_HOST=devapi.qweather.com

# 可选油价 Provider：TianAPI 优先，JUHE 兜底。两者均未配置或不可用时，工具返回
# 明确说明。每日生活简报不包含油价。
TIANAPI_KEY=
JUHE_KEY=

# ---- Web 仪表盘与只读 REST API（可选，src/server/）----
# HOST：绑定地址，默认 127.0.0.1（仅本机回环）。API 无内置认证，暴露到局域网/公网前
# 必须配置 WEB_API_TOKEN，否则任何访问者都能用 ?profile= 越权读取任意身份数据。
# HOST=127.0.0.1
# 需要局域网/公网访问时：
# HOST=0.0.0.0
# WEB_API_TOKEN=<长随机字符串>

# WEBCORS_ORIGIN：额外的 CORS 白名单来源（逗号分隔）。默认只放行本机回环
# 127.0.0.1/localhost/[::1] 任意端口；从特定域名跨域访问时才需要设置。
# WEBCORS_ORIGIN=https://your.domain

# 仅用于说明迁移 no-op；新部署不要配置：
# NOTIFY_WEBHOOK_URL=
# BARK_URL=
# SERVERCHAN_SENDKEY=
