# ===== 基础 =====
# 数据目录（SQLite/WAL 与旧 store.json 迁移源），默认 ./data
DATA_DIR=./data

# ===== 统一主动通知 =====
# JSON：Profile → Hermes 本地 deliver-only Webhook。公共通知会为每个配置的 Profile 各投递一次，私有日程只投递所属 Profile。
# secret 必须使用 randomBytes(32) 生成的 64 位随机十六进制值。
# 真实 .env 必须 chmod 600，禁止提交 Git。
# PROFILE_PUSH_ROUTES_JSON={"default":{"route":"qqbot","url":"http://127.0.0.1:8644/webhooks/life-assistant-reminder","secret":"REPLACE_WITH_64_HEX_CHARS"},"bestie":{"route":"qqbot","url":"http://127.0.0.1:8645/webhooks/life-assistant-reminder","secret":"REPLACE_WITH_64_HEX_CHARS"}}
PROFILE_PUSH_ROUTES_JSON=

# 位置（首次运行可不填，Agent 会引导确认；填入后跳过确认）
LOCATION_CITY=
LOCATION_LAT=
LOCATION_LON=

# 调度 IANA 时区；留空时使用运行环境本地时区
LIFE_ASSISTANT_TIMEZONE=Asia/Shanghai

# ===== 天气 =====
# 可选：和风天气 Key（免费版即可，用于官方气象预警；不填则降级为阈值推断）
QWEATHER_KEY=

# 确定性天气生活简报，默认每天本地时间 07:00
DAILY_WEATHER_BRIEF_CRON="0 7 * * *"

# ===== 油价 =====
# 可选：天行/聚合数据油价 API Key；均不填时晨间简报自动省略油价
TIANAPI_KEY=
JUHE_KEY=

# ===== 快递 =====
# 快递100 实时查询 API 授权（https://kuaidi100.com 免费注册）
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=

# NOTIFY_WEBHOOK_URL / BARK_URL / SERVERCHAN_SENDKEY 已停用。
# 所有主动通知只走 PROFILE_PUSH_ROUTES_JSON → Hermes Webhook → 一个 Gateway 平台。
