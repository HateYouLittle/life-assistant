# ===== 基础 =====
# 数据目录（store.json 存放位置），默认 ./data
DATA_DIR=./data

# 位置（首次运行可不填，Agent 会引导确认；填入后跳过确认）
LOCATION_CITY=
LOCATION_LAT=
LOCATION_LON=

# ===== 天气 =====
# 可选：和风天气 Key（免费版即可，用于官方气象预警；不填则降级为阈值推断）
QWEATHER_KEY=

# ===== 油价 =====
# 可选：聚合数据油价 API Key（低成本；不填则使用内置示例 Provider 并提示配置）
JUHE_KEY=

# ===== 快递 =====
# 快递100 实时查询 API 授权（https://kuaidi100.com 免费注册）
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=

# ===== 通知通道（可多个同时生效） =====
# stdout 默认开启；以下为可选通道
NOTIFY_WEBHOOK_URL=          # 通用 webhook，POST JSON {title, body, time}
BARK_URL=                    # 如 https://api.day.app/你的key
SERVERCHAN_SENDKEY=          # Server酱 SendKey（微信推送）
