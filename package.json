{
  "name": "life-assistant",
  "version": "0.3.0",
  "description": "Personal life assistant for Hermes Agent: weather, oil prices, Profile-private schedules, CN holidays/workdays, and reliable Hermes Webhook notifications.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && npm run build:web",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "start": "node dist/index.js",
    "start:scheduler": "node dist/scheduler.js",
    "dev": "tsx src/index.ts",
    "dev:scheduler": "tsx src/scheduler.ts",
    "start:web": "node dist/server/index.js",
    "dev:web": "tsx src/server/index.ts",
    "build:web": "npm --prefix web run build",
    "postinstall": "npm --prefix web install"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "hono": "^4.13.2",
    "lunar-javascript": "^1.7.7",
    "luxon": "^3.7.2",
    "node-cron": "^3.0.3",
    "rrule": "^2.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.3",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
